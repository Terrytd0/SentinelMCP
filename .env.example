# Copy to .env and fill in real values for your environment:
#   cp .env.example .env
# .env is gitignored -- never commit real credentials.
#
# Every variable below is loaded by backend/config/settings.py via
# pydantic-settings. The prefix is `SENTINEL_` and the field name mirrors the
# variable name lowercased, so `SENTINEL_DATABASE_URL` -> `settings.database_url`
# with no translation table to get wrong. Nothing outside backend/config/ reads
# os.environ.

# --- Application ---
SENTINEL_APP_NAME=SentinelMCP
# "production" activates the startup refusals: the default JWT secret is
# rejected and SENTINEL_ALLOW_AUTO_MERGE cannot be set (see
# backend/auth/jwt.py and backend/policy/rules.py).
SENTINEL_APP_ENV=development
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8000
SENTINEL_LOG_LEVEL=INFO

# --- PostgreSQL: system of record for findings, tickets, proposals, audit ---
# Host-local default. `docker compose up` overrides this to the in-network
# service name (postgres:5432) in the compose file itself, so you only need to
# change this line if you run Postgres somewhere other than compose.
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
# Optional. Leave blank to derive the sync DSN by swapping the asyncpg driver
# for psycopg2 -- Alembic runs synchronously and cannot use asyncpg.
SENTINEL_DATABASE_URL_SYNC=
SENTINEL_DB_ECHO=false

# --- Redis ---
# Intentionally absent. An earlier revision of this project declared a Redis
# service, a SENTINEL_REDIS_URL, a SENTINEL_SCAN_CACHE_TTL_SECONDS, and a
# fakeredis dev dependency "for rate limiting and a scan-result cache" -- and
# implemented none of it. Redis is not part of this sprint's scope: the roadmap
# builds it properly in Sprint 4 (SupportOps AI) and reuses it in Sprints 7 and
# 10. Declaring a cache that does not exist is worse than having no cache,
# because a reader assumes it is there. If you add real caching, add it here
# and in docker-compose.yml in the same commit.

# --- Auth ---
# CHANGE THIS. Startup refuses the default when SENTINEL_APP_ENV=production,
# and a weak secret here means anyone can mint an ANALYST token for the triage
# API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_JWT_SECRET=dev-only-insecure-secret-change-me
SENTINEL_JWT_ALGORITHM=HS256
SENTINEL_ACCESS_TOKEN_EXPIRE_MINUTES=60
# false runs the API and MCP server open. Sensible for a local demo, never for
# a real deployment. With auth on, the demo accounts seeded by
# `python -m backend.scripts.seed` are the way in.
SENTINEL_AUTH_ENABLED=true

# --- gRPC scanning service ---
SENTINEL_GRPC_SERVER_HOST=0.0.0.0
SENTINEL_GRPC_SERVER_PORT=50051
SENTINEL_GRPC_CLIENT_TARGET=localhost:50051
SENTINEL_GRPC_TIMEOUT_SECONDS=30

# --- Scanners ---
# Subset of the names the registry knows: fixture, semgrep. An unknown name is
# rejected at startup rather than silently yielding a service that reports
# healthy and then errors on every request. `semgrep` is auto-disabled when the
# binary at SENTINEL_SEMGREP_BINARY is not executable, so listing it here is
# safe on a machine without Semgrep.
#
# List-valued settings take JSON, not a comma-separated string: pydantic-settings
# parses complex types with json.loads, so `fixture,semgrep` is a SettingsError
# at import time, not a silently-one-element list.
SENTINEL_ENABLED_SCANNERS=["fixture"]
# Absolute path to the semgrep binary, or just `semgrep` to resolve it on PATH.
SENTINEL_SEMGREP_BINARY=semgrep
SENTINEL_FIXTURES_DIR=data/fixtures
SENTINEL_CVE_FEED_DIR=data/cve

# --- AutoGen remediation loop ---
# false (the default) uses the deterministic rule-based developer/reviewer, so
# the entire remediation path is runnable and testable with no API key and no
# network. true uses live AutoGen agents and requires a key below.
# See docs/adr/002-autogen-vs-langgraph-crewai.md.
SENTINEL_AUTOGEN_ENABLED=false
SENTINEL_LLM_MODEL=gpt-4o-mini
# Leave blank unless SENTINEL_AUTOGEN_ENABLED=true. Never commit a real key.
SENTINEL_LLM_API_KEY=
# Set to an OpenAI-compatible endpoint to point the model client somewhere
# else (a local vLLM/Ollama gateway, for example).
SENTINEL_LLM_BASE_URL=
# Cap on developer<->reviewer critique rounds. Past this the loop escalates to
# a human rather than burning tokens on an unwinnable argument between two
# agents.
SENTINEL_REMEDIATION_MAX_ROUNDS=3
# Hard cap on billable LLM calls per remediation.
SENTINEL_REMEDIATION_MAX_LLM_CALLS=8

# --- Pull-request safety rails (the hard guarantees) ---
# There is no supported configuration in which this is true.
# backend/policy/rules.py::assert_human_merge_required refuses to start with
# it set, and the publisher never sets auto_merge_blocked=False. Do not set it.
SENTINEL_ALLOW_AUTO_MERGE=false
SENTINEL_TARGET_REPO=ironclad-cyber/sentinel-remediations
SENTINEL_TARGET_BASE_BRANCH=main

# --- SLA policy: hours to remediate, by severity ---
SENTINEL_SLA_CRITICAL_HOURS=4
SENTINEL_SLA_HIGH_HOURS=24
SENTINEL_SLA_MEDIUM_HOURS=168
SENTINEL_SLA_LOW_HOURS=720
SENTINEL_SLA_INFO_HOURS=2160
# "At risk" = past this fraction of the SLA but not yet breached. Drives the
# dashboard's amber state.
SENTINEL_SLA_AT_RISK_FRACTION=0.75

# --- Auto-remediation safety rails ---
# Path prefixes the agent may draft patches under. Anything outside this list is
# refused by backend/policy/rules.py -- an agent that can patch
# infra/terraform/prod/ can break production. JSON list, as above.
SENTINEL_REMEDIATION_SOURCE_ROOTS=["app/","src/","services/","lib/","config/"]
# How much source the remediation loop is shown around a finding.
#
# A scanner reports ONE line. The reviewer judges a multi-line patch, and its
# scope check needs enough source to judge against -- so the loop is shown the
# finding's enclosing block (the smallest indented run containing it, plus the
# header that opens it) rather than the bare line. `backend/scanners/snippet.py`.
#
# Which strategy was used is recorded on the audit row as `snippet_strategy`, so
# a reviewer of the audit trail knows whether the loop was shown a block, a
# window, or the scanner's own line because the file could not be read.
#
# A ceiling rather than a fixed width, because a finding inside a 2,000-line
# class would otherwise put the whole class in an LLM prompt. 120 lines holds a
# substantial function and costs about 1.5k tokens against the default model.
# 0 means "no ceiling", not "show nothing".
SENTINEL_REMEDIATION_SNIPPET_MAX_LINES=120

# --- Telemetry: the Aegis (Sprint 11) fleet contract ---
# file  -> append JSONL to SENTINEL_TELEMETRY_FILE
# http  -> POST each event to SENTINEL_TELEMETRY_ENDPOINT
# null  -> discard
# Every emit is wrapped and swallowed: telemetry must never be able to fail the
# operation it is measuring. See backend/telemetry/README.md.
SENTINEL_TELEMETRY_SINK=file
SENTINEL_TELEMETRY_ENDPOINT=
SENTINEL_TELEMETRY_FILE=data/telemetry/events.jsonl
SENTINEL_TELEMETRY_TIMEOUT_SECONDS=2.0
# Must match the tenant name registered in the Aegis fleet registry, because
# fleet metrics are keyed by this.
SENTINEL_TELEMETRY_SERVICE=SentinelMCP

# --- Test database (used only by the integration suite) ---
# A dedicated database so a test run can never truncate working data. The
# integration fixtures truncate rather than recreate the schema, and skip
# themselves when this is unreachable -- see tests/integration/README.md.
SENTINEL_TEST_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_test
